--// LOCAL COMMAND FUNCTIONS
--// =========================================================

local Running = false
local NoclipConnection = nil
local FlyConnection = nil

local function Character()
	return LocalPlayer.Character
end

local function Humanoid()
	local char = Character()
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function ExecuteLocalCommand(command, args)
	command = string.lower(command)

	if command == "speed" or command == "walkspeed" then
		local value = tonumber(args[1]) or 16
		local hum = Humanoid()

		if hum then
			hum.WalkSpeed = value
		end

	elseif command == "jump" or command == "jumppower" then
		local value = tonumber(args[1]) or 50
		local hum = Humanoid()

		if hum then
			hum.JumpPower = value
		end

	elseif command == "sit" then
		local hum = Humanoid()

		if hum then
			hum.Sit = true
		end

	elseif command == "unsit" then
		local hum = Humanoid()

		if hum then
			hum.Sit = false
		end

	elseif command == "reset" or command == "respawn" then
		local hum = Humanoid()

		if hum then
			hum.Health = 0
		end

	elseif command == "gravity" then
		workspace.Gravity = tonumber(args[1]) or 196.2

	elseif command == "fov" then
		local camera = workspace.CurrentCamera

		if camera then
			camera.FieldOfView = tonumber(args[1]) or 70
		end

	elseif command == "invisible" then
		local char = Character()

		if char then
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.LocalTransparencyModifier = 1
				elseif obj:IsA("Decal") then
					obj.Transparency = 1
				end
			end
		end

	elseif command == "visible" then
		local char = Character()

		if char then
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					obj.LocalTransparencyModifier = 0
				elseif obj:IsA("Decal") then
					obj.Transparency = 0
				end
			end
		end

	elseif command == "noclip" then
		if NoclipConnection then
			NoclipConnection:Disconnect()
		end

		NoclipConnection = game:GetService("RunService").Stepped:Connect(function()
			local char = Character()

			if char then
				for _, obj in ipairs(char:GetDescendants()) do
					if obj:IsA("BasePart") then
						obj.CanCollide = false
					end
				end
			end
		end)

	elseif command == "clip" then
		if NoclipConnection then
			NoclipConnection:Disconnect()
			NoclipConnection = nil
		end

	elseif command == "clear" then
		for _, child in ipairs(HistoryScroll:GetChildren()) do
			if child:IsA("TextLabel") then
				child:Destroy()
			end
		end

	elseif command == "refresh" then
		RefreshPlayers()
		RefreshSuggestions()

	elseif command == "fullbright" then
		local Lighting = game:GetService("Lighting")
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false

	elseif command == "zoom" then
		local camera = workspace.CurrentCamera

		if camera then
			camera.FieldOfView = 30
		end

	elseif command == "unzoom" then
		local camera = workspace.CurrentCamera

		if camera then
			camera.FieldOfView = 70
		end

	elseif command == "normal" then
		local hum = Humanoid()

		if hum then
			hum.WalkSpeed = 16
			hum.JumpPower = 50
		end

		local camera = workspace.CurrentCamera

		if camera then
			camera.FieldOfView = 70
		end

	elseif command == "fly" then
		local root = Character() and Character():FindFirstChild("HumanoidRootPart")

		if root and not FlyConnection then
			FlyConnection = game:GetService("RunService").RenderStepped:Connect(function()
				if root then
					root.AssemblyLinearVelocity = Vector3.new(
						root.AssemblyLinearVelocity.X,
						0,
						root.AssemblyLinearVelocity.Z
					)
				end
			end)
		end

	elseif command == "unfly" then
		if FlyConnection then
			FlyConnection:Disconnect()
			FlyConnection = nil
		end

	elseif command == "help" then
		CommandInput.Text = "speed 100"
	end
end

--// =========================================================
--// EXECUTE
--// =========================================================

local function ExecuteCommand()
	local text = CommandInput.Text

	if text == "" then
		return
	end

	local parts = string.split(text, " ")
	local commandName = string.lower(parts[1])

	table.remove(parts, 1)

	local command = FindCommand(commandName)

	if not command then
		ReadyText.Text = "Unbekannter Command"
		ReadyText.TextColor3 = CONFIG.Red

		task.delay(2, function()
			ReadyText.Text = "Bereit"
			ReadyText.TextColor3 = CONFIG.Green
		end)

		return
	end

	Running = true

	local targetName = SelectedPlayer and SelectedPlayer.Name or "Alle Spieler"

	AddHistory(text, targetName)

	local success, err = pcall(function()
		ExecuteLocalCommand(commandName, parts)
	end)

	if success then
		ReadyText.Text = "Command ausgeführt"
		ReadyText.TextColor3 = CONFIG.Green
	else
		ReadyText.Text = "Fehler"
		ReadyText.TextColor3 = CONFIG.Red
		warn(err)
	end

	task.delay(2, function()
		if Running then
			ReadyText.Text = "Bereit"
			ReadyText.TextColor3 = CONFIG.Green
		end
	end)
end

Execute.MouseButton1Click:Connect(function()
	ExecuteCommand()
end)

CommandInput.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		ExecuteCommand()
	end
end)

