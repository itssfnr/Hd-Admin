--==================================================
-- TREE
--==================================================

local function MatchesSearch(object, query)
	if query == "" then
		return true
	end

	return string.find(
		string.lower(object.Name),
		query,
		1,
		true
	) ~= nil
end

local function HasMatchingChild(object, query)
	for _, child in ipairs(object:GetChildren()) do
		if MatchesSearch(child, query) then
			return true
		end

		if HasMatchingChild(child, query) then
			return true
		end
	end

	return false
end

local RenderTree

local function CreateRow(object, depth)
	local hasChildren = #object:GetChildren() > 0

	local Row = New("TextButton", {
		Size = UDim2.new(1, -5, 0, 27),
		BackgroundColor3 =
			object == Selected
			and COLORS.Selected
			or Color3.fromRGB(0, 0, 0),
		BackgroundTransparency =
			object == Selected
			and 0
			or 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false
	}, Tree)

	local indent = depth * 17

	local Arrow = New("TextLabel", {
		Size = UDim2.fromOffset(17, 27),
		Position = UDim2.fromOffset(indent, 0),
		BackgroundTransparency = 1,
		Text = hasChildren
			and (Expanded[object] and "▼" or "▶")
			or "",
		TextColor3 = COLORS.Muted,
		Font = Enum.Font.GothamBold,
		TextSize = 9
	}, Row)

	local Icon = New("TextLabel", {
		Size = UDim2.fromOffset(25, 27),
		Position = UDim2.fromOffset(indent + 17, 0),
		BackgroundTransparency = 1,
		Text = GetIcon(object),
		TextSize = 12
	}, Row)

	local Name = New("TextLabel", {
		Size = UDim2.new(1, -(indent + 48), 1, 0),
		Position = UDim2.fromOffset(indent + 44, 0),
		BackgroundTransparency = 1,
		Text = object.Name,
		TextColor3 = object == Selected
			and Color3.fromRGB(255,255,255)
			or COLORS.Text,
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left
	}, Row)

	Row.MouseEnter:Connect(function()
		if object ~= Selected then
			Row.BackgroundColor3 = COLORS.Hover
			Row.BackgroundTransparency = 0
		end
	end)

	Row.MouseLeave:Connect(function()
		if object ~= Selected then
			Row.BackgroundTransparency = 1
		end
	end)

	Row.MouseButton1Click:Connect(function()
		Selected = object
		ShowProperties(object)

		if hasChildren then
			Expanded[object] = not Expanded[object]
		end

		RenderTree()
	end)
end

RenderTree = function()
	for _, child in ipairs(Tree:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local query = string.lower(Search.Text)

	local function RenderObject(object, depth)
		local visible =
			MatchesSearch(object, query)
			or HasMatchingChild(object, query)

		if not visible then
			return
		end

		CreateRow(object, depth)

		local shouldOpen =
			Expanded[object]
			or query ~= ""

		if shouldOpen then
			local children = object:GetChildren()

			table.sort(children, function(a, b)
				return string.lower(a.Name) < string.lower(b.Name)
			end)

			for _, child in ipairs(children) do
				RenderObject(child, depth + 1)
			end
		end
	end

	local roots = game:GetChildren()

	table.sort(roots, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)

	for _, root in ipairs(roots) do
		RenderObject(root, 0)
	end

	Tree.CanvasSize = UDim2.fromOffset(
		0,
		#Tree:GetChildren() * 27 + 20
	)
end

