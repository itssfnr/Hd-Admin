local function createObject(className)

	if not selectedObject then
		return
	end

	local parent = selectedObject

	if not parent:IsA("Instance") then
		return
	end

	local success, obj = pcall(function()
		return Instance.new(className)
	end)

	if success and obj then
		obj.Name = className
		obj.Parent = parent

		if obj:IsA("BasePart") then
			obj.Size = Vector3.new(4, 1, 4)

			if parent:IsA("BasePart") then
				obj.CFrame = parent.CFrame + Vector3.new(0, 3, 0)
			elseif parent:IsA("Model") then
				obj.Position = parent:GetPivot().Position + Vector3.new(0, 3, 0)
			else
				obj.Position = Vector3.new(0, 5, 0)
			end
		end

		expanded[parent] = true
		buildTree()
	end

	AddMenu.Visible = false
end

