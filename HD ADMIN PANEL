local function GetCategoryColor(category)
	if category == "Movement" then
		return CONFIG.Green
	elseif category == "Visuals" then
		return CONFIG.Purple
	elseif category == "Player" then
		return CONFIG.Cyan
	elseif category == "Admin" then
		return CONFIG.Red
	elseif category == "Teleport" then
		return CONFIG.Purple
	elseif category == "Fun" then
		return CONFIG.Yellow
	end

	return CONFIG.Blue
end

local function CreateSuggestion(command)
	local Row = New("TextButton", {
		Size = UDim2.new(1, -8, 0, 34),
		BackgroundColor3 = Color3.fromRGB(20, 29, 43),
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false
	}, SuggestScroll)

	Corner(Row, 6)

	local Name = New("TextLabel", {
		Size = UDim2.fromOffset(120, 34),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Text = command.name .. " " .. command.args,
		TextColor3 = CONFIG.Text,
		Font = Enum.Font.Code,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left
	}, Row)

	local Description = New("TextLabel", {
		Size = UDim2.new(1, -240, 1, 0),
		Position = UDim2.fromOffset(135, 0),
		BackgroundTransparency = 1,
		Text = command.desc,
		TextColor3 = CONFIG.Muted,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left
	}, Row)

	local Category = New("TextLabel", {
		Size = UDim2.fromOffset(80, 22),
		Position = UDim2.new(1, -90, 0.5, -11),
		BackgroundColor3 = GetCategoryColor(command.cat),
		BackgroundTransparency = 0.35,
		Text = command.cat,
		TextColor3 = CONFIG.Text,
		Font = Enum.Font.GothamBold,
		TextSize = 8
	}, Row)

	Corner(Category, 5)

	Row.MouseEnter:Connect(function()
		Tween(Row, 0.1, {
			BackgroundColor3 = Color3.fromRGB(30, 45, 65)
		})
	end)

	Row.MouseLeave:Connect(function()
		Tween(Row, 0.1, {
			BackgroundColor3 = Color3.fromRGB(20, 29, 43)
		})
	end)

	Row.MouseButton1Click:Connect(function()
		CommandInput.Text = command.name .. " "
		CommandInput:CaptureFocus()
	end)
end

local function RefreshSuggestions()
	for _, child in ipairs(SuggestScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local query = string.lower(CommandInput.Text)
	local commandPart = string.split(query, " ")[1] or ""

	local shown = 0

	for _, command in ipairs(Commands) do
		local categoryMatches =
			SelectedCategory == "All Commands"
			or command.cat == SelectedCategory

		local searchMatches =
			commandPart == ""
			or string.find(string.lower(command.name), commandPart, 1, true)

		if categoryMatches and searchMatches then
			CreateSuggestion(command)

			shown += 1

			if shown >= 12 then
				break
			end
		end
	end

	SuggestScroll.CanvasSize = UDim2.fromOffset(
		0,
		SuggestLayout.AbsoluteContentSize.Y + 10
	)
end

RefreshSuggestions()

CommandInput:GetPropertyChangedSignal("Text"):Connect(RefreshSuggestions)

