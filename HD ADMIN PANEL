--==================================================
-- SHOW PROPERTIES
--==================================================

local function ShowProperties(object)
	ClearProperties()

	if not object then
		return
	end

	PropertiesTitle.Text = "PROPERTIES  •  " .. object.Name

	Property("Name", object.Name)
	Property("ClassName", object.ClassName)
	Property("Parent", object.Parent and object.Parent:GetFullName() or "nil")
	Property("Archivable", object.Archivable)

	if object:IsA("BasePart") then
		Property("Position", object.Position)
		Property("Size", object.Size)
		Property("Anchored", object.Anchored)
		Property("CanCollide", object.CanCollide)
		Property("Transparency", object.Transparency)
		Property("Material", object.Material)
		Property("Color", object.Color)
	end

	if object:IsA("Model") then
		local primary = object.PrimaryPart

		Property(
			"PrimaryPart",
			primary and primary.Name or "None"
		)
	end

	if object:IsA("Humanoid") then
		Property("Health", object.Health)
		Property("MaxHealth", object.MaxHealth)
		Property("WalkSpeed", object.WalkSpeed)
		Property("JumpPower", object.JumpPower)
	end

	if object:IsA("ValueBase") then
		Property("Value", object.Value)
	end

	if object:IsA("Folder") then
		Property("Children", #object:GetChildren())
	end

	Property("FullName", object:GetFullName())

	PropertyScroll.CanvasSize = UDim2.fromOffset(
		0,
		PropertyLayout.AbsoluteContentSize.Y + 10
	)
end

