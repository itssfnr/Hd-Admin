local function addProperty(name, value, editable, callback)

	local Row = Instance.new("Frame")
	Row.Size = UDim2.new(1, -10, 0, 34)
	Row.BackgroundColor3 = THEME.Panel
	Row.BorderColor3 = THEME.Border
	Row.Parent = PropScroll

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Size = UDim2.new(.42, 0, 1, 0)
	NameLabel.BackgroundTransparency = 1
	NameLabel.Text = "  " .. name
	NameLabel.TextColor3 = THEME.Text
	NameLabel.TextSize = 12
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left
	NameLabel.Parent = Row

	if editable then
		local Box = Instance.new("TextBox")
		Box.Size = UDim2.new(.56, -5, 1, -6)
		Box.Position = UDim2.new(.42, 0, 0, 3)
		Box.BackgroundColor3 = THEME.Background
		Box.BorderColor3 = THEME.Border
		Box.Text = tostring(value)
		Box.TextColor3 = THEME.Text
		Box.TextSize = 12
		Box.ClearTextOnFocus = false
		Box.Parent = Row

		Box.FocusLost:Connect(function()
			if callback then
				callback(Box.Text)
			end
		end)
	else
		local Value = Instance.new("TextLabel")
		Value.Size = UDim2.new(.56, -5, 1, 0)
		Value.Position = UDim2.new(.42, 0, 0, 0)
		Value.BackgroundTransparency = 1
		Value.Text = tostring(value)
		Value.TextColor3 = THEME.SubText
		Value.TextSize = 12
		Value.TextXAlignment = Enum.TextXAlignment.Left
		Value.Parent = Row
	end
end

local function showProperties(obj)

	clearProperties()

	if not obj then
		PropertiesTitle.Text = "  PROPERTIES"
		return
	end

	PropertiesTitle.Text = "  PROPERTIES  •  " .. obj.Name

	addProperty("Name", obj.Name, true, function(v)
		if v ~= "" then
			obj.Name = v
			RefreshButton:Activate()
		end
	end)

	addProperty("ClassName", obj.ClassName, false)
	addProperty("FullName", obj:GetFullName(), false)

	if obj.Parent then
		addProperty("Parent", obj.Parent:GetFullName(), false)
	end

	if obj:IsA("BasePart") then

		addProperty("Position", tostring(obj.Position), false)

		addProperty("Size", tostring(obj.Size), false)

		addProperty("Transparency", obj.Transparency, true, function(v)
			local n = tonumber(v)
			if n then
				obj.Transparency = math.clamp(n, 0, 1)
			end
		end)

		addProperty("Anchored", obj.Anchored, true, function(v)
			obj.Anchored = v:lower() == "true"
		end)

		addProperty("CanCollide", obj.CanCollide, true, function(v)
			obj.CanCollide = v:lower() == "true"
		end)

	end

	if obj:IsA("Model") then
		addProperty("Pivot", tostring(obj:GetPivot().Position), false)
	end

	if obj:IsA("Humanoid") then
		addProperty("Health", obj.Health, true, function(v)
			local n = tonumber(v)
			if n then
				obj.Health = n
			end
		end)

		addProperty("WalkSpeed", obj.WalkSpeed, true, function(v)
			local n = tonumber(v)
			if n then
				obj.WalkSpeed = n
			end
		end)
	end

	if obj:IsA("ValueBase") then
		addProperty("Value", obj.Value, true, function(v)
			pcall(function()
				if obj:IsA("StringValue") then
					obj.Value = v
				elseif obj:IsA("IntValue") then
					obj.Value = tonumber(v) or obj.Value
				elseif obj:IsA("NumberValue") then
					obj.Value = tonumber(v) or obj.Value
				elseif obj:IsA("BoolValue") then
					obj.Value = v:lower() == "true"
				end
			end)
		end)
	end

	PropScroll.CanvasSize = UDim2.fromOffset(0, PropLayout.AbsoluteContentSize.Y)
end

