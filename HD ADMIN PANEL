--==================================================
-- DUPLICATE
--==================================================

DuplicateButton.MouseButton1Click:Connect(function()

	if selectedObject and selectedObject ~= workspace then

		local success, clone = pcall(function()
			return selectedObject:Clone()
		end)

		if success and clone and selectedObject.Parent then

			clone.Name = selectedObject.Name .. "_Copy"
			clone.Parent = selectedObject.Parent

			if clone:IsA("BasePart") then
				clone.Position += Vector3.new(3, 0, 0)
			elseif clone:IsA("Model") then
				clone:PivotTo(clone:GetPivot() + Vector3.new(3, 0, 0))
			end

			buildTree()
		end
	end

end)

