local expanded = {}

local function clearExplorer()
	for _, v in ipairs(Scroll:GetChildren()) do
		if v:IsA("GuiObject") then
			v:Destroy()
		end
	end
end

local function createNode(obj, depth, order)

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1, -8, 0, 24)
	Button.BackgroundTransparency = 1
	Button.BorderSizePixel = 0
	Button.Text = ""
	Button.LayoutOrder = order
	Button.Parent = Scroll

	local Arrow = Instance.new("TextLabel")
	Arrow.Size = UDim2.fromOffset(18, 24)
	Arrow.Position = UDim2.fromOffset(depth * 18, 0)
	Arrow.BackgroundTransparency = 1
	Arrow.TextColor3 = THEME.SubText
	Arrow.TextSize = 11
	Arrow.Text = #obj:GetChildren() > 0 and (expanded[obj] and "▼" or "▶") or ""
	Arrow.Parent = Button

	local Icon = Instance.new("TextLabel")
	Icon.Size = UDim2.fromOffset(22, 24)
	Icon.Position = UDim2.fromOffset(depth * 18 + 18, 0)
	Icon.BackgroundTransparency = 1
	Icon.Text = getIcon(obj)
	Icon.TextSize = 14
	Icon.Parent = Button

	local Label = Instance.new("TextLabel")
	Label.Size = UDim2.new(1, -(depth * 18 + 45), 1, 0)
	Label.Position = UDim2.fromOffset(depth * 18 + 42, 0)
	Label.BackgroundTransparency = 1
	Label.Text = obj.Name
	Label.TextColor3 = THEME.Text
	Label.TextSize = 12
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.Parent = Button

	Button.MouseEnter:Connect(function()
		if selectedObject ~= obj then
			Button.BackgroundTransparency = 0
			Button.BackgroundColor3 = THEME.Hover
		end
	end)

	Button.MouseLeave:Connect(function()
		if selectedObject ~= obj then
			Button.BackgroundTransparency = 1
		end
	end)

	Button.MouseButton1Click:Connect(function()

		selectedObject = obj

		for _, item in ipairs(Scroll:GetChildren()) do
			if item:IsA("TextButton") then
				item.BackgroundTransparency = 1
			end
		end

		Button.BackgroundTransparency = 0
		Button.BackgroundColor3 = THEME.Selected

		if #obj:GetChildren() > 0 then
			expanded[obj] = not expanded[obj]
		end

		showProperties(obj)
		task.defer(function()
			-- refresh tree
		end)
	end)

	return Button
end

local function buildTree()

	clearExplorer()

	local query = Search.Text:lower()
	local order = 0

	local function recurse(parent, depth)

		for _, obj in ipairs(parent:GetChildren()) do

			if query == "" or obj.Name:lower():find(query, 1, true) then

				order += 1
				createNode(obj, depth, order)

				if expanded[obj] then
					recurse(obj, depth + 1)
				end

			elseif query ~= "" then

				local hasMatch = false

				for _, d in ipairs(obj:GetDescendants()) do
					if d.Name:lower():find(query, 1, true) then
						hasMatch = true
						break
					end
				end

				if hasMatch then
					order += 1
					createNode(obj, depth, order)
					expanded[obj] = true
					recurse(obj, depth + 1)
				end
			end
		end
	end

	-- Roblox Studio-style roots
	local roots = {
		game:GetService("Workspace"),
		game:GetService("Players"),
		game:GetService("Lighting"),
		game:GetService("ReplicatedStorage"),
		game:GetService("ServerStorage"),
		game:GetService("StarterGui"),
		game:GetService("StarterPack"),
		game:GetService("StarterPlayer"),
		game:GetService("SoundService"),
		game:GetService("Teams"),
		game:GetService("MaterialService"),
		game:GetService("TextChatService"),
	}

	for _, root in ipairs(roots) do
		if root then
			order += 1
			createNode(root, 0, order)

			if expanded[root] then
				recurse(root, 1)
			end
		end
	end

	Scroll.CanvasSize = UDim2.fromOffset(0, Layout.AbsoluteContentSize.Y + 10)
end

