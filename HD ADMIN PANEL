--// Lokale Commands
local Commands = {}

Commands.speed = function(value)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.WalkSpeed = tonumber(value) or 16
	end
end

Commands.jump = function(value)
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.JumpPower = tonumber(value) or 50
	end
end

Commands.reset = function()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.Health = 0
	end
end

Commands.sit = function()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.Sit = true
	end
end

Commands.unsit = function()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		humanoid.Sit = false
	end
end

Commands.invisible = function()
	local character = LocalPlayer.Character

	if character then
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.LocalTransparencyModifier = 1
			elseif obj:IsA("Decal") then
				obj.Transparency = 1
			end
		end
	end
end

Commands.visible = function()
	local character = LocalPlayer.Character

	if character then
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.LocalTransparencyModifier = 0
			elseif obj:IsA("Decal") then
				obj.Transparency = 0
			end
		end
	end
end

Commands.gravity = function(value)
	workspace.Gravity = tonumber(value) or 196.2
end

Commands.fov = function(value)
	local camera = workspace.CurrentCamera

	if camera then
		camera.FieldOfView = tonumber(value) or 70
	end
end

Commands.noclip = function()
	local character = LocalPlayer.Character

	if not character then
		return
	end

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = false
		end
	end
end

Commands.clip = function()
	local character = LocalPlayer.Character

	if not character then
		return
	end

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = true
		end
	end
end

--// Command ausführen
local function ExecuteCommand()
	local text = CommandBox.Text

	if text == "" then
		return
	end

	local args = string.split(text, " ")
	local commandName = string.lower(args[1])

	table.remove(args, 1)

	AddHistory("> " .. text)

	if Commands[commandName] then
		Running = true
		Status.Text = "Ausgeführt für: " .. SelectedPlayer.Name

		local success, err = pcall(function()
			Commands[commandName](table.unpack(args))
		end)

		if success then
			Status.Text = "✓ Command ausgeführt"
		else
			Status.Text = "✕ Fehler: " .. tostring(err)
		end
	else
		Status.Text = "✕ Unbekannter Command: " .. commandName
	end
end

Execute.MouseButton1Click:Connect(ExecuteCommand)

CommandBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		ExecuteCommand()
	end
end)

Stop.MouseButton1Click:Connect(function()
	Running = false
	Status.Text = "■ Gestoppt"
	AddHistory("> COMMAND STOPPED")
end)

--// F6 = Panel öffnen/schließen
UIS.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.F6 then
		Main.Visible = not Main.Visible
	end
end)

--// Drag-System
local dragging = false
local dragStart
local startPos

Title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = Main.Position
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart

		Main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

Status.Text = "Bereit • F6 zum Öffnen/Schließen"
